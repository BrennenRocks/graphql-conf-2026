{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@apollo/server": "catalog:",
    "@graphql-conf/api": "workspace:*",
    "@graphql-conf/db": "workspace:*",
    "@graphql-conf/env": "workspace:*",
    "dotenv": "catalog:",
    "graphql": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@graphql-conf/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2"
  }
}
