{
  "name": "graphql-conf",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@apollo/client": "^4.1.7",
      "@apollo/server": "^5.5.0",
      "@graphql-codegen/cli": "^6.2.1",
      "@graphql-codegen/client-preset": "^5.2.4",
      "@graphql-codegen/typescript-apollo-client-helpers": "^4.0.0",
      "@graphql-typed-document-node/core": "^3.2.0",
      "@types/bun": "^1.3.4",
      "hono": "^4.8.2",
      "better-auth": "1.6.2",
      "graphql": "^16.13.2",
      "graphql-tag": "^2.12.6",
      "lucide-react": "^1.8.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "sonner": "^2.0.5",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18",
      "drizzle-orm": "^0.45.1",
      "@types/pg": "^8.16.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "codegen": "turbo -F web codegen",
    "watch:codegen": "turbo -F web watch:codegen",
    "db:push": "turbo -F @graphql-conf/db db:push",
    "db:studio": "turbo -F @graphql-conf/db db:studio",
    "db:generate": "turbo -F @graphql-conf/db db:generate",
    "db:migrate": "turbo -F @graphql-conf/db db:migrate",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@graphql-conf/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@graphql-conf/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.8.12",
    "typescript": "^6.0.2",
    "ultracite": "7.4.4"
  },
  "packageManager": "bun@1.3.11"
}
